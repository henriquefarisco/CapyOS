# Central, immutable sibling refs used by CapyOS CI and release builds.
# Override only for an explicit pre-release validation run. A production
# release must use tags, never moving branches such as main/develop.
CAPYUI_REF="${CAPYUI_REF:-v2.25.0}"
CAPYBROWSER_REF="${CAPYBROWSER_REF:-v0.6.8}"
CAPYCODECS_REF="${CAPYCODECS_REF:-v0.0.13}"
CAPYAGENT_REF="${CAPYAGENT_REF:-v0.1.0}"
CAPYLANG_REF="${CAPYLANG_REF:-v0.1.13}"
CAPYBENCHMARK_REF="${CAPYBENCHMARK_REF:-v0.0.12}"

# CapyAI v0.2.2 adds the Etapa 9 package compatibility metadata while
# preserving the leakage-free model and core artifact v0.
CAPYAI_REF="${CAPYAI_REF:-v0.2.2}"
