# Central, immutable sibling refs used by CapyOS CI and release builds.
# Override only for an explicit pre-release validation run. A production
# release must use tags, never moving branches such as main/develop.
CAPYUI_REF="${CAPYUI_REF:-v2.24.1}"
CAPYBROWSER_REF="${CAPYBROWSER_REF:-v0.6.7}"
CAPYCODECS_REF="${CAPYCODECS_REF:-v0.0.12}"
CAPYAGENT_REF="${CAPYAGENT_REF:-v0.0.10}"
CAPYLANG_REF="${CAPYLANG_REF:-v0.1.12}"
CAPYBENCHMARK_REF="${CAPYBENCHMARK_REF:-v0.0.11}"

# CapyAI v0.2.0 adds governed orchestration while preserving core artifact v0.
CAPYAI_REF="${CAPYAI_REF:-v0.2.0}"
